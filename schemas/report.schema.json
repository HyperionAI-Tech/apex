        "proof_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof By"
        },
        "statement_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement By"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "UNSUPPORTED_CONSTRUCT",
        "IMPURE_IO",
        "FLOAT_SEMANTICS",
        "NONTERMINATION",
        "BUDGET_EXHAUSTED",
        "SPEC_AMBIGUOUS",
        "SPEC_CONFLICT",
        "NEEDS_CONCURRENCY_TOOL",
        "PROOF_REJECTED",
        "NO_STATEMENT"
