          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "found_by": {
          "enum": [
            "crosshair",
            "hypothesis",
            "example"
          ],
          "title": "Found By",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        }
      },
      "required": [
        "inputs",
        "found_by"
      ],
      "title": "Counterexample",
      "type": "object"
