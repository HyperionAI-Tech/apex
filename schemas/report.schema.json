{
  "$defs": {
    "Counterexample": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "found_by": {
          "enum": [
            "crosshair",
            "hypothesis",
            "example",
            "fuzz",
            "stress"
          ],
          "title": "Found By",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "object"
        }
      },
      "required": [
        "inputs",
        "found_by"
      ],
      "title": "Counterexample",
      "type": "object"
    },
    "FidelitySummary": {
      "additionalProperties": false,
      "properties": {
        "agree": {
          "title": "Agree",
          "type": "boolean"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "inputs_checked": {
          "title": "Inputs Checked",
          "type": "integer"
        },
        "mismatch": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counterexample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "skipped": {
          "default": 0,
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "agree",
        "inputs_checked"
      ],
      "title": "FidelitySummary",
      "type": "object"
    },
    "FunctionResult": {
      "additionalProperties": false,
      "properties": {
        "fidelity": {
          "anyOf": [
            {
              "$ref": "#/$defs/FidelitySummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "properties": {
          "items": {
            "$ref": "#/$defs/PropertyResult"
          },
          "title": "Properties",
          "type": "array"
        },
        "pure_core": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pure Core"
        },
        "purity": {
          "default": "unknown",
          "enum": [
            "pure",
            "impure",
            "unknown"
          ],
          "title": "Purity",
          "type": "string"
        },
        "qualname": {
          "title": "Qualname",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "qualname",
        "file",
        "sha256"
      ],
      "title": "FunctionResult",
      "type": "object"
    },
    "FuzzEvidence": {
      "additionalProperties": false,
      "description": "One property's fuzzing campaign, as `apex fuzz` recorded it.",
      "properties": {
        "engine": {
          "enum": [
            "hypothesis",
            "atheris"
          ],
          "title": "Engine",
          "type": "string"
        },
        "executions": {
          "title": "Executions",
          "type": "integer"
        },
        "found": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counterexample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "function_sha256": {
          "title": "Function Sha256",
          "type": "string"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "skipped": {
          "default": 0,
          "title": "Skipped",
          "type": "integer"
        }
      },
      "required": [
        "property_id",
        "hint",
        "function_sha256",
        "engine",
        "executions",
        "seconds"
      ],
      "title": "FuzzEvidence",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "next_steps": {
          "items": {
            "type": "string"
          },
          "title": "Next Steps",
          "type": "array"
        },
        "reason_code": {
          "$ref": "#/$defs/ReasonCode"
        }
      },
      "required": [
        "reason_code",
        "explanation"
      ],
      "title": "Gap",
      "type": "object"
    },
    "LeanError": {
      "additionalProperties": false,
      "description": "One Lean error on a rejected proof, positioned in the file the author edits.",
      "properties": {
        "column": {
          "title": "Column",
          "type": "integer"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "goal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal"
        },
        "line": {
          "title": "Line",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "message"
      ],
      "title": "LeanError",
      "type": "object"
    },
    "ModelCheckEvidence": {
      "additionalProperties": false,
      "description": "One TLA+ invariant: TLC's check of the spec plus the conformance of the real code.",
      "properties": {
        "constants": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Constants",
          "type": "object"
        },
        "depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        },
        "distinct_states": {
          "default": 0,
          "title": "Distinct States",
          "type": "integer"
        },
        "function_sha256": {
          "title": "Function Sha256",
          "type": "string"
        },
        "invariant": {
          "title": "Invariant",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "property_id": {
          "title": "Property Id",
          "type": "string"
        },
        "rejected_trace": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Trace"
        },
        "runs": {
          "default": 0,
          "title": "Runs",
          "type": "integer"
        },
        "spec_sha256": {
          "title": "Spec Sha256",
          "type": "string"
        },
        "states_generated": {
          "default": 0,
          "title": "States Generated",
          "type": "integer"
        },
        "tlc_trace": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tlc Trace"
        },
        "traces_checked": {
          "default": 0,
          "title": "Traces Checked",
          "type": "integer"
        }
      },
      "required": [
        "property_id",
        "invariant",
        "spec_sha256",
        "function_sha256"
      ],
      "title": "ModelCheckEvidence",
      "type": "object"
    },
    "ProofArtifact": {
      "additionalProperties": false,
      "properties": {
        "axioms": {
          "items": {
            "type": "string"
          },
          "title": "Axioms",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "axioms"
      ],
      "title": "ProofArtifact",
      "type": "object"
    },
    "PropertyResult": {
      "additionalProperties": false,
      "properties": {
        "added_preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Added Preconditions",
          "type": "array"
        },
        "counterexample": {
          "anyOf": [
            {
              "$ref": "#/$defs/Counterexample"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fuzz": {
          "anyOf": [
            {
              "$ref": "#/$defs/FuzzEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/Gap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "lean_errors": {
          "items": {
            "$ref": "#/$defs/LeanError"
          },
          "title": "Lean Errors",
          "type": "array"
        },
        "lean_statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lean Statement"
        },
        "model_check": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCheckEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proof": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProofArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/Review"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "id",
        "verdict"
      ],
      "title": "PropertyResult",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Which model proposed each candidate. Recorded for debugging, never for trust.",
      "properties": {
        "proof_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof By"
        },
        "statement_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement By"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "ReasonCode": {
      "enum": [
        "UNSUPPORTED_CONSTRUCT",
        "IMPURE_IO",
        "FLOAT_SEMANTICS",
        "NONTERMINATION",
        "BUDGET_EXHAUSTED",
        "SPEC_AMBIGUOUS",
        "SPEC_CONFLICT",
        "NEEDS_CONCURRENCY_TOOL",
        "PROOF_REJECTED",
        "NO_STATEMENT",
        "SPEC_VIOLATION_NOT_REPRODUCED",
        "MODEL_CHECK_FAILED"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "lapsed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Review",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "proven",
        "proven_unreviewed",
        "proven_conditional",
        "refuted",
        "fidelity_failed",
        "contradiction",
        "unproven",
        "out_of_scope",
        "fuzzed",
        "model_checked"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apex_version": {
      "title": "Apex Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "functions": {
      "items": {
        "$ref": "#/$defs/FunctionResult"
      },
      "title": "Functions",
      "type": "array"
    },
    "lean_toolchain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lean Toolchain"
    },
    "mathlib_rev": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mathlib Rev"
    },
    "mode": {
      "enum": [
        "engine",
        "host"
      ],
      "title": "Mode",
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "apex_version",
    "mode",
    "exit_code"
  ],
  "title": "Report",
  "type": "object"
}
